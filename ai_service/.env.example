# Database (same Neon instance as Django)
DATABASE_URL=postgresql://veritasrag:veritasrag@localhost:5432/veritasrag

# Internal API key — must match Django INTERNAL_API_KEY
INTERNAL_API_KEY=change-this-to-a-random-secret

# Google AI embeddings (gemini-embedding-001, 768 dimensions)
GOOGLE_API_KEY=your-google-api-key-here

# OpenRouter chat generation (Gemini 3.1 Flash Lite primary, GPT-5.4 Mini fallback)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_CHAT_MODELS=google/gemini-3.1-flash-lite,openai/gpt-5.4-mini

# Cloudinary (for fetching uploaded files during ingestion)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
